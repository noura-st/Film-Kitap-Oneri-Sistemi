<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!--
            Local development default: Windows authentication against a local
            SQL Server Express instance.

            To point the app at another server, edit this value. Do not put a
            password in plain text here and commit it - use Integrated Security,
            or keep the credentials in a file that is gitignored.
        -->
        <add name="RecommendationDB"
             connectionString="Server=localhost\SQLEXPRESS;Database=RecommendationDB;Trusted_Connection=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
