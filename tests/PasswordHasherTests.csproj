<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Standalone test runner for PasswordHasher.

    The app itself targets .NET Framework 4.7.2, but these tests are compiled for
    .NET 8 so they run anywhere with the SDK installed: `dotnet run` in this
    folder. They only exercise PasswordHasher, which has no Windows Forms or
    database dependency, so the target framework does not change what is tested.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <RootNamespace>RecommendationApp.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PasswordHasherTests.cs" />
    <Compile Include="..\RecommendationApp\RecommendationApp\PasswordHasher.cs" Link="PasswordHasher.cs" />
  </ItemGroup>
</Project>
